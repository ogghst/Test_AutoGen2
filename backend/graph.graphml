    <node id="house_construction_001">
      <data key="d15">house_construction_001</data>
      <data key="d0">Residential House Construction Project</data>
      <data key="d6">To build a high-quality, energy-efficient single-family home that meets all safety standards and provides comfortable living space for the occupants</data>
      <data key="d1">Complete construction of a 2,500 sq ft single-family residence with 4 bedrooms, 3 bathrooms, and modern amenities including energy-efficient systems and smart home technology</data>
      <data key="d2">Hybrid</data>
      <data key="d3">Concept</data>
      <data key="d4">Initiation</data>
      <data key="d7">2024-01-15</data>
      <data key="d8">2024-01-15</data>
      <data key="d5">Project</data>
    </node>
    <node id="bc_house_001">
      <data key="d15">bc_house_001</data>
      <data key="d16">house_construction_001</data>
      <data key="d17">Lack of adequate housing that meets modern energy efficiency standards and provides comfortable living space for a family of 4-5 members</data>
      <data key="d18">Estimated construction budget of $350,000-$450,000 including materials, labor, permits, and contingencies</data>
      <data key="d19">Expected 15-20% return on investment through property appreciation and energy savings over 5 years</data>
      <data key="d20">Considered purchasing existing property (higher maintenance costs, lower energy efficiency) vs. new construction (higher upfront cost but better long-term value)</data>
      <data key="d21">Proceed with new construction to achieve optimal energy efficiency, customization, and long-term value</data>
      <data key="d22">Proposed</data>
      <data key="d5">BusinessCase</data>
    </node>
    <node id="house_construction_project_001">
      <data key="d15">house_construction_project_001</data>
      <data key="d0">Single-Family Home Construction</data>
